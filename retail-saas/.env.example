# Copy this file to .env and fill in your local values:
#   cp .env.example .env
#
# Never commit .env — it is gitignored and may contain secrets.

# ---- Application ----
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-string

# ---- Database (required) ----
# Local MySQL example — adjust user, password, host, port, and database name
DATABASE_URL=mysql+pymysql://retailuser:retail456@localhost:3306/retail_saas


# ---- JWT (optional — defaults shown) ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Redis / Celery (defaults match docker-compose redis service) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- AWS S3 (optional — leave empty for local dev) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=retail-saas-files

# ---- WhatsApp API (optional) ----
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- CORS (optional) ----
# Comma-separated origins or JSON array
# Frontend: testing.myretailos.com | API/Swagger: api-testing.myretailos.com
CORS_ORIGINS=["https://testing.myretailos.com","https://retail-os.netlify.app","http://localhost:3000","http://localhost:5173","http://localhost:5174"]
